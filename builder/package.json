{
  "name": "@addorimprove/yamlai",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "yamlai": "dist/scripts/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
